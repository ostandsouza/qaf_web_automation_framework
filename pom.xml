<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.template.automation</groupId>
	<artifactId>QAF_Template_PROJECT</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>QAF_Template_PROJECT</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<testSuiteFile>config/sanity_config.xml</testSuiteFile>
		<sourceVersion>11</sourceVersion>
		<targetVersion>11</targetVersion>
		<qaf.version>4.0.0-RC3</qaf.version>
		<restassured.version>5.5.0</restassured.version>
		<selenium.version>4.14.1</selenium.version>
		<appium.version>9.0.0</appium.version>
		<testng.version>7.1.0</testng.version>
		<assist.version>3.28.0-GA</assist.version>
		<test.results.dir>test-results</test.results.dir>
		<run.time>${maven.build.timestamp}</run.time>
		<lib.dir>${project.basedir}/lib</lib.dir>
		<resource.dir>${project.basedir}/resources</resource.dir>
		<output.dir>${test.results.dir}/${run.time}</output.dir>
		<maven.build.timestamp.format>dd_MMM_yyyy_hh_mm_aa</maven.build.timestamp.format>
		<testng.report.title>Demo</testng.report.title>
	</properties>
	<repositories>
